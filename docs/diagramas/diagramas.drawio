ze=12;" vertex="1" parent="1"><mxGeometry x="1080" y="544" width="50" height="20" as="geometry"/></mxCell><mxCell id="n26" value='&lt;font style="font-size:11px" color="#1F2933"&gt;motors[ ]&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;fontColor=#1F2933;align=left;" vertex="1" parent="1"><mxGeometry x="1080" y="524" width="120" height="20" as="geometry"/></mxCell><mxCell id="n27" value="source" style="html=1;fontFamily=Helvetica;strokeColor=#1F2933;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=open;endFill=0;endSize=9;exitX=1;exitY=0.4;entryX=0;entryY=0.5;verticalAlign=bottom;" edge="1" parent="1" source="n6" target="n8"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-3" as="offset"/></mxGeometry></mxCell><mxCell id="n28" value="gripper_state" style="html=1;fontFamily=Helvetica;strokeColor=#1F2933;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;labelBackgroundColor=#FFFFFF;edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;endFill=0;endSize=9;exitX=0.3;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="n12" target="n10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="139" y="430"/><mxPoint x="190" y="430"/></Array><mxPoint x="56" y="-8" as="offset"/></mxGeometry></mxCell><mxCell id="n29" value="&lt;b&gt;Nota&lt;/b&gt;&lt;br&gt;En el JSON los campos del gripper y del AX-18A van sueltos dentro de la muestra; solo los motores van en una lista. Aquí se agrupan para leerlos mejor." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;shape=note;size=14;fillColor=#FEF3C7;strokeColor=#92400E;fontColor=#1F2933;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="930" y="790" width="280" height="112" as="geometry"/></mxCell><mxCell id="n30" value='&lt;font style="font-size:11px" color="#616E7C"&gt;«/» indica un campo calculado por Node-RED. Un campo sin medición se omite o va en null; nunca se rellena con cero.&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;fontColor=#1F2933;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="800" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>