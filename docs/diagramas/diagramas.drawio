rent="n4"><mxGeometry x="0" y="48" width="340" height="72" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Muestra&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;swimlane;startSize=30;fillColor=#E4E7EB;strokeColor=#1F2933;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontStyle=0;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="340" height="162" as="geometry"/></mxCell><mxCell id="n7" value='&lt;div style="line-height:20px"&gt;device_id&lt;font color="#616E7C"&gt;: texto&lt;/font&gt;&lt;br&gt;boot_id&lt;font color="#616E7C"&gt;: texto &amp;nbsp;cambia en cada reinicio&lt;/font&gt;&lt;br&gt;source&lt;font color="#616E7C"&gt;: Origen&lt;/font&gt;&lt;br&gt;seq&lt;font color="#616E7C"&gt;: entero &amp;nbsp;creciente&lt;/font&gt;&lt;br&gt;sample_time_ms&lt;font color="#616E7C"&gt;: entero&lt;/font&gt;&lt;br&gt;calibration_id&lt;font color="#616E7C"&gt;: texto &amp;nbsp;[0..1]&lt;/font&gt;&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;fontColor=#1F2933;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;overflow=hidden;" vertex="1" parent="n6"><mxGeometry x="0" y="30" width="340" height="132" as="geometry"/></mxCell><mxCell id="n8" value='&lt;font style="font-size:11px" color="#616E7C"&gt;«enumeración»&lt;/font&gt;&lt;br&gt;&lt;b&gt;Origen&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;swimlane;startSize=48;fillColor=#E4E7EB;strokeColor=#1F2933;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontStyle=0;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="960" y="315" width="200" height="100" as="geometry"/></mxCell><mxCell id="n9" value='&lt;div style="line-height:20px"&gt;real&lt;br&gt;simulated&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;fontColor=#1F2933;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;overflow=hidden;" vertex="1" parent="n8"><mxGeometry x="0" y="48" width="200" height="52" as="geometry"/></mxCell><mxCell id="n10" value='&lt;font style="font-size:11px" color="#616E7C"&gt;«enumeración»&lt;/font&gt;&lt;br&gt;&lt;b&gt;EstadoGripper&lt;/b&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;swimlane;startSize=48;fillColor=#E4E7EB;strokeColor=#1F2933;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontStyle=0;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="240" height="180" as="geometry"/></mxCell><mxCell id="n11" value='&lt;div style="line-height:20px"&gt;idle = 0&lt;br&gt;opening = 1&lt;br&gt;closing = 2&lt;br&gt;holding = 3&lt;br&gt;fault = 4&lt;br&gt;homing = 5&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;fontColor=#1F2933;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;overflow=hidden;" vertex="1" parent="n10"><mxGeometry x="0" y="48" width="240" height="132" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Gripper&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;swimlane;startSize=30;fillColor=#E4E7EB;strokeColor=#1F2933;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontStyle=0;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="330" height="322" as="geometry"/></mxCell><mxCell id="n13" value='&lt;div style="line-height:20px"&gt;opening_mm&lt;font color="#616E7C"&gt;: decimal&lt;/font&gt;&lt;br&gt;opening_target_mm&lt;font color="#616E7C"&gt;: decimal &amp;nbsp;0 – 85&lt;/font&gt;&lt;br&gt;opening_speed_mm_s&lt;font color="#616E7C"&gt;: decimal&lt;/font&gt;&lt;br&gt;grip_force_n&lt;font color="#616E7C"&gt;: decimal&lt;/font&gt;&lt;br&gt;force_limit_n&lt;font color="#616E7C"&gt;: decimal&lt;/font&gt;&lt;br&gt;cycle_time_s&lt;font color="#616E7C"&gt;: decimal&lt;/font&gt;&lt;br&gt;gripper_state&lt;font color="#616E7C"&gt;: EstadoGripper&lt;/font&gt;&lt;br&gt;object_detected&lt;font color="#616E7C"&gt;: booleano&lt;/font&gt;&lt;br&gt;limit_open&lt;font color="#616E7C"&gt;: booleano&lt;/font&gt;&lt;br&gt;limit_closed&lt;font color="#616E7C"&gt;: booleano&lt;/font&gt;&lt;br&gt;motor_blocked&lt;font color="#616E7C"&gt;: booleano&lt;/font&gt;&lt;br&gt;communication_error&lt;font color="#616E7C"&gt;: booleano&lt;/font&gt;&lt;br&gt;overcurrent_alarm&lt;font color="#616E7C"&gt;: booleano&lt;/font&gt;&lt;br&gt;/ opening_out_of_range&lt;font color="#616E7C"&gt;: booleano&lt;/font&gt;&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;fontColor=#1F2933;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;overflow=hidden;" vertex="1" parent="n12"><mxGeometry x="0" y="30" width="330" height="292" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;ServoAX18A&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;swimlane;startSize=30;fillColor=#E4E7EB;strokeColor=#1F2933;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontStyle=0;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="470" y="570" width="360" height="162" as="geometry"/></mxCell><mxCell id="n15" value='&lt;div style="line-height:20px"&gt;ax_position_ticks&lt;font color="#616E7C"&gt;: entero &amp;nbsp;0 – 1023&lt;/font&gt;&lt;br&gt;ax_position_deg&lt;font color="#616E7C"&gt;: decimal &amp;nbsp;0 – 300&lt;/font&gt;&lt;br&gt;ax_speed_rpm&lt;font color="#616E7C"&gt;: decimal &amp;nbsp;con signo&lt;/font&gt;&lt;br&gt;ax_load_pct&lt;font color="#616E7C"&gt;: decimal &amp;nbsp;−100 – 100&lt;/font&gt;&lt;br&gt;ax_voltage_v&lt;font color="#616E7C"&gt;: decimal&lt;/font&gt;&lt;br&gt;ax_temperature_c&lt;font color="#616E7C"&gt;: decimal&lt;/font&gt;&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;fontColor=#1F2933;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;overflow=hidden;" vertex="1" parent="n14"><mxGeometry x="0" y="30" width="360" height="132" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;Motor&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;swimlane;startSize=30;fillColor=#E4E7EB;strokeColor=#1F2933;strokeWidth=1.5;fontColor=#1F2933;fontSize=13;fontStyle=0;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="930" y="570" width="280" height="162" as="geometry"/></mxCell><mxCell id="n17" value='&lt;div style="line-height:20px"&gt;id&lt;font color="#616E7C"&gt;: entero &amp;nbsp;1 – 6&lt;/font&gt;&lt;br&gt;encoder_pulses&lt;font color="#616E7C"&gt;: entero&lt;/font&gt;&lt;br&gt;encoder_deg&lt;font color="#616E7C"&gt;: decimal&lt;/font&gt;&lt;br&gt;rpm&lt;font color="#616E7C"&gt;: decimal &amp;nbsp;con signo&lt;/font&gt;&lt;br&gt;current_a&lt;font color="#616E7C"&gt;: decimal&lt;/font&gt;&lt;br&gt;blocked&lt;font color="#616E7C"&gt;: booleano&lt;/font&gt;&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;fontColor=#1F2933;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;overflow=hidden;" vertex="1" parent="n16"><mxGeometry x="0" y="30" width="280" height="132" as="geometry"/></mxCell><mxCell id="n18" value="" style="html=1;fontFamily=Helvetica;strokeColor=#1F2933;strokeWidth=1.5;fontColor=#1F2933;fontSize=12;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=0;endSize=12;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value='&lt;font style="font-size:11px" color="#616E7C"&gt;es una Muestra más lo que añade el servidor&lt;/font&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;text;strokeColor=none;fillColor=none;fontColor=#1F2933;align=left;" vertex="1" parent="1"><mxGeometry x="660" y="238" width="230" height="22" as="geometry"/></mxCell><mxCell id="n20" value="" style="html=1;fontFamily=Helvetica;strokeColor=#1F2933;strokeWidth=1.5